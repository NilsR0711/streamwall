{
  "name": "streamwall",
  "version": "0.10.5",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:app": "npm -w packages/streamwall start",
    "start:server": "npm -w packages/streamwall-control-client run build && npm -w packages/streamwall-control-server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "npm -w streamwall-control-e2e run test:e2e",
    "licenses:check": "node scripts/check-licenses.mjs",
    "release:version": "node scripts/release-version.mjs"
  },
  "workspaces": [
    "packages/streamwall",
    "packages/streamwall-shared",
    "packages/streamwall-control-client",
    "packages/streamwall-control-server",
    "packages/streamwall-control-ui",
    "packages/streamwall-control-e2e"
  ],
  "overrides": {
    "tar": "^7.5.16",
    "tmp": "^0.2.6",
    "@electron/asar": {
      "minimatch": {
        "brace-expansion": "^1.1.13"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "js-yaml": "^5.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
